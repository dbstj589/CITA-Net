{
  "@context": {
    "stkg": "https://example.org/stkg/",
    "geo": "https://example.org/geo/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",

    "Entity": "stkg:Entity",
    "Observation": "stkg:Observation",
    "Event": "stkg:Event",
    "Landmark": "stkg:Landmark",

    "time": {"@id": "stkg:time", "@type": "xsd:dateTime"},
    "objectType": "stkg:objectType",
    "typeConfidence": {"@id": "stkg:typeConfidence", "@type": "xsd:double"},
    "state": "stkg:state",
    "stateConfidence": {"@id": "stkg:stateConfidence", "@type": "xsd:double"},
    "labelText": "stkg:labelText",
    "source": "stkg:source",
    "cepM": {"@id": "stkg:cepM", "@type": "xsd:double"},
    "speedMps": {"@id": "stkg:speedMps", "@type": "xsd:double"},
    "headingDeg": {"@id": "stkg:headingDeg", "@type": "xsd:double"},
    "observationOf": {"@id": "stkg:observationOf", "@type": "@id"},
    "participatesIn": {"@id": "stkg:participatesIn", "@type": "@id"},
    "role": "stkg:role",

    "easting": {"@id": "geo:easting", "@type": "xsd:double"},
    "northing": {"@id": "geo:northing", "@type": "xsd:double"},
    "elevation": {"@id": "geo:elevation", "@type": "xsd:double"},
    "crs": "geo:crs",
    "mgrs": "geo:mgrs",

    "partOf": {"@id": "stkg:partOf", "@type": "@id"},
    "follows": {"@id": "stkg:follows", "@type": "@id"},
    "near": {"@id": "stkg:near", "@type": "@id"},
    "firesAt": {"@id": "stkg:firesAt", "@type": "@id"},
    "engagedWith": {"@id": "stkg:engagedWith", "@type": "@id"},
    "emplacedAt": {"@id": "stkg:emplacedAt", "@type": "@id"},
    "movesToward": {"@id": "stkg:movesToward", "@type": "@id"},
    "supports": {"@id": "stkg:supports", "@type": "@id"},
    "screens": {"@id": "stkg:screens", "@type": "@id"},

    "wasAttributedTo": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "generatedAtTime": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"}
  }
}
